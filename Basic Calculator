#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

int calculate(char* s) {
    int n = strlen(s);
    
    int* stack_result = (int*)malloc(n * sizeof(int));
    int* stack_sign = (int*)malloc(n * sizeof(int));
    int top = 0;
    
    int result = 0;
    int sign = 1; 
    
    for (int i = 0; i < n; i++) {
        char c = s[i];
        
        if (isdigit(c)) {
            long long num = 0;
            while (i < n && isdigit(s[i])) {
                num = num * 10 + (s[i] - '0');
                i++;
            }
            i--;
            
            result += sign * num;
        } 
        else if (c == '+') {
            sign = 1;
        } 
        else if (c == '-') {
            sign = -1;
        } 
        else if (c == '(') {
            stack_result[top] = result;
            stack_sign[top] = sign;
            top++;
            
            result = 0;
            sign = 1;
        } 
        else if (c == ')') {
            top--;
            int prev_sign = stack_sign[top];
            int prev_result = stack_result[top];
            
            result = prev_result + prev_sign * result;
        }
    }
    
    free(stack_result);
    free(stack_sign);
    
    return result;
}
