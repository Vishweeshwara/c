int romanToInt(char* s) {
    int roman[128];
    roman['I'] = 1;
    roman['V'] = 5;
    roman['X'] = 10;
    roman['L'] = 50;
    roman['C'] = 100;
    roman['D'] = 500;
    roman['M'] = 1000;

    int total = 0;
    for (int i = 0; s[i] != '\0'; i++) {
        if (s[i+1] != '\0' && roman[s[i]] < roman[s[i+1]]) {
            total -= roman[s[i]];
        } else {
            total += roman[s[i]];
        }
    }
    return total;
}
