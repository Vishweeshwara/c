#include <stdio.h>

int main() {
    int n, temp, reverse = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    while (temp != 0) {
        reverse = reverse * 10 + temp % 10;
        temp /= 10;
    }

    if (reverse == n)
        printf("Palindrome\n");
    else
        printf("Not a Palindrome\n");

    return 0;
}
