#include <stdlib.h>
#include <stdbool.h>

#define MAX_SIZE 30005

typedef struct {
    int* data;
    int* min_data;
    int top_idx;
} MinStack;

MinStack* minStackCreate() {
    MinStack* stack = (MinStack*)malloc(sizeof(MinStack));
    stack->data = (int*)malloc(sizeof(int) * MAX_SIZE);
    stack->min_data = (int*)malloc(sizeof(int) * MAX_SIZE);
    stack->top_idx = -1;
    return stack;
}

void minStackPush(MinStack* obj, int val) {
    obj->top_idx++;
    obj->data[obj->top_idx] = val;
    
    if (obj->top_idx == 0) {
        obj->min_data[obj->top_idx] = val;
    } else {
        int current_min = obj->min_data[obj->top_idx - 1];
        obj->min_data[obj->top_idx] = (val < current_min) ? val : current_min;
    }
}

void minStackPop(MinStack* obj) {
    if (obj->top_idx >= 0) {
        obj->top_idx--;
    }
}

int minStackTop(MinStack* obj) {
    return obj->data[obj->top_idx];
}

int minStackGetMin(MinStack* obj) {
    return obj->min_data[obj->top_idx];
}

void minStackFree(MinStack* obj) {
    free(obj->data);
    free(obj->min_data);
    free(obj);
}
